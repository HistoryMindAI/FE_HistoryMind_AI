# .env.example
# Copy this file to .env for production settings, or .env.local for local overrides.

# API URL
# For production deployment on Vercel, this points to the Railway backend:
# VITE_API_URL=https://behistorymindai-production.up.railway.app

# For local development with proxy (to use http://localhost:8080 via Vite proxy):
# Create a .env.local file and set:
# VITE_API_URL=
# (Leave empty to use the proxy configured in vite.config.ts)
